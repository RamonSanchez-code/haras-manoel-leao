# Domínio público do site (sem barra no final). Usado em canonical, Open Graph, sitemap e robots.
VITE_SITE_URL=https://SEU-DOMINIO.com.br

# Endpoint opcional para o formulário de contato (ex.: Formspree, Getform, API própria).
# Deve aceitar POST JSON. Se vazio, o formulário envia a mensagem pelo WhatsApp.
VITE_FORM_ENDPOINT=

# "true" mostra as marcações de conteúdo pendente (fotos, horários, textos a confirmar).
# Mude para "false" quando todo o conteúdo oficial estiver aprovado.
VITE_SHOW_PENDING=true
